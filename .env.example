# ──────────────────────────────────────────
#  Mercy Map Vote Bot – Environment Variables
# ──────────────────────────────────────────

# ── Discord Bot ──────────────────────────
MERCY_BOT_TOKEN=your_bot_token_here
MERCY_CLIENT_ID=your_client_id_here
MERCY_CLIENT_SECRET=your_client_secret_here
MERCY_GUILD_ID=your_guild_id_here

# ── Pterodactyl Panel ────────────────────
# Used to auto-update map seed, restart server, and send skinbox commands
PTERODACTYL_PANEL_URL=https://your.panel.url
PTERODACTYL_API_KEY=ptlc_your_api_key_here
PTERODACTYL_SERVER_ID=your_server_id_here

# ── Map Vote Channels ─────────────────────
# Channel where wipe announcement is posted after a vote completes
WIPE_FEED_CHANNEL_ID=your_channel_id_here
# Optional: server connect IP shown in wipe announcements (e.g. 1.2.3.4:28015)
SERVER_CONNECT_IP=your_server_ip:28015

# ── Rustmaps API ─────────────────────────
# Get your key at https://rustmaps.com/user/profile
RUSTMAPS_API_KEY=your_rustmaps_api_key_here

# ── Skin Request ─────────────────────────
# Channel where /skinrequest posts skin suggestions for community voting
MERCY_SKIN_CHANNEL_ID=your_skin_channel_id_here
# Role ID that is allowed to approve skin requests (leave blank to allow anyone with ManageMessages)
MERCY_STAFF_ROLE_ID=your_staff_role_id_here

# ── Dashboard (optional) ─────────────────
# Only needed if you use the web dashboard
MERCY_DASHBOARD_PORT=3006
MERCY_DASHBOARD_WHITELIST=
MERCY_PUBLIC_URL=http://your-server-ip:3006
MERCY_SESSION_SECRET=change_me