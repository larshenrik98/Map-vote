# ─────────────────────────────────────────────────────────
# MercyBot — Environment Variables
# Copy this file to .env and fill in all required values.
# Lines starting with # are comments.
# ─────────────────────────────────────────────────────────


# ── DISCORD ───────────────────────────────────────────────

# Your Discord bot token (from discord.com/developers → Bot → Token)
MERCY_BOT_TOKEN=your_bot_token_here

# Your Discord Application ID (from discord.com/developers → General Information → Application ID)
MERCY_CLIENT_ID=your_client_id_here

# Your Discord Client Secret (from discord.com/developers → OAuth2 → Client Secret)
# Required for dashboard login
MERCY_CLIENT_SECRET=your_client_secret_here

# Your Discord Server (Guild) ID
# Right-click your server in Discord → Copy Server ID (requires Developer Mode enabled)
MERCY_GUILD_ID=your_guild_id_here

# Comma-separated Discord User IDs allowed to access the web dashboard
# To find your ID: Developer Mode → right-click your name → Copy User ID
MERCY_DASHBOARD_WHITELIST=123456789012345678,987654321098765432


# ── WEB DASHBOARD ─────────────────────────────────────────

# Port the dashboard runs on (default: 3006)
MERCY_DASHBOARD_PORT=3006

# Public URL of the dashboard (used for Discord OAuth2 redirect)
# For a VPS: http://your-vps-ip:3006
# For a domain: https://yourdomain.com
MERCY_PUBLIC_URL=http://your-vps-ip:3006

# Session secret — make this a long random string, e.g. run: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_secret_string


# ── PTERODACTYL ───────────────────────────────────────────

# Your Pterodactyl panel URL (no trailing slash)
PTERODACTYL_PANEL_URL=https://panel.pinehosting.com

# Pterodactyl Client API Key
# In your panel: Account → API Credentials → Create
PTERODACTYL_API_KEY=ptlc_your_api_key_here

# (Optional) Default server ID if you only have one server.
# The bot will use this if no server_id is specified.
# Find it in the Pterodactyl panel URL when viewing your server.
PTERODACTYL_SERVER_ID=abc12345


# ── MAP VOTE ──────────────────────────────────────────────

# Shared secret between this bot and the MercyMapVote.cs Oxide plugin.
# Make this a unique, random string. Must match "Api Secret" in the plugin config.
MAPVOTE_API_SECRET=MyUniqueMapVoteSecret123

# Your Rustmaps.com API key
# Get it at: https://rustmaps.com/user/profile → API Keys
RUSTMAPS_API_KEY=your_rustmaps_api_key_here


# ── WIPE ANNOUNCEMENTS ────────────────────────────────────

# Discord Channel ID where wipe announcements are posted
# Right-click the channel in Discord → Copy Channel ID
WIPE_FEED_CHANNEL_ID=your_wipe_feed_channel_id_here

# Your Rust server's connect IP and port shown in wipe announcements
# Format: ip:port (e.g. 123.45.67.89:28015)
SERVER_CONNECT_IP=your.server.ip:28015


# ── OPTIONAL / ADVANCED ───────────────────────────────────

# Host the dashboard binds to (default: 0.0.0.0 = all interfaces)
MERCY_BIND_HOST=0.0.0.0
